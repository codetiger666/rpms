#!/usr/bin/make -f
# 编译规则，configure/make/make install
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	CFLAGS="-fPIC" ./configure --prefix=/usr/local/nginx --sbin-path=/usr/sbin/nginx --conf-path=/usr/local/nginx/nginx.conf --pid-path=/var/run/nginx.pid \
	--error-log-path=/var/log/nginx/error.log --http-log-path=/var/log/nginx/access.log --lock-path=/var/lock/nginx.lock --with-luajit --with-http_gunzip_module \
	--with-pcre --with-pcre-jit --with-http_perl_module --with-ld-opt="-Wl,-E" --with-http_realip_module --with-http_secure_link_module --with-http_slice_module \
	--with-http_ssl_module --with-http_stub_status_module --with-http_sub_module --with-http_v2_module --with-http_addition_module --with-http_xslt_module \
	--with-http_image_filter_module --with-http_geoip_module --with-http_dav_module --with-http_flv_module --with-http_mp4_module --with-http_gzip_static_module \
	--with-http_auth_request_module --with-http_random_index_module --with-select_module --with-poll_module --with-file-aio --with-http_degradation_module --with-libatomic \
	--http-client-body-temp-path=/var/tmp/nginx/client_body --http-proxy-temp-path=/var/tmp/nginx/proxy --http-fastcgi-temp-path=/var/tmp/nginx/fastcgi \
	--http-uwsgi-temp-path=/var/tmp/nginx/uwsgi --http-scgi-temp-path=/var/tmp/nginx/scgi --add-module=/opt/nginx-upstream-dynamic-servers --add-module=/opt/ngx_upstream_jdomain \
	--with-stream --with-stream_ssl_module --with-stream_realip_module --with-stream_geoip_module --with-stream_ssl_preread_module -j$$(nproc)

override_dh_auto_build:
	make -j$$(nproc)

override_dh_auto_install:
	make install DESTDIR=$(CURDIR)/debian/tmp
	install -p -D -m 0644 debian/nginx.conf $(CURDIR)/debian/tmp/usr/local/nginx/nginx.conf
	install -p -D -m 0644 debian/default.conf $(CURDIR)/debian/tmp/usr/local/nginx/conf.d/default.conf
	install -p -D -m 0644 debian/stream.conf.example $(CURDIR)/debian/tmp/usr/local/nginx/conf.d/stream.example
	install -p -D -m 0644 debian/ssl.conf.example $(CURDIR)/debian/tmp/usr/local/nginx/conf.d/ssl.conf.example
	install -p -D -m 0644 debian/nginx.service $(CURDIR)/debian/tmp/lib/systemd/system/nginx.service

override_dh_usrlocal:

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/tmp/usr/local/nginx/luajit/lib